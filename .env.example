# Postgres connection string (Neon, Vercel Postgres, Supabase or local)
DATABASE_URL=postgres://lb:lb@localhost:5432/lineboard
# Long random string used to sign session cookies: openssl rand -base64 32
AUTH_SECRET=change-me
# Optional. When set, attachments go to Vercel Blob; otherwise they are stored on local disk in ./uploads
BLOB_READ_WRITE_TOKEN=
